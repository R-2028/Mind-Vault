# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public key for client-side Google Maps / Places embedding.
# Must be restricted via HTTP referrer restrictions in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=""

# NOTIFICATION_WEBHOOK_URL: Optional server-side Webhook (Slack / Discord) for sanitized notifications.
# Never exposed to client browser.
NOTIFICATION_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# RESEND_API_KEY: Optional server-side email dispatch key for sanitized action alerts.
RESEND_API_KEY=""

